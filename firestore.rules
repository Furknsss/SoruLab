rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function isValidTestResult(data) {
      let keys = [
        'userId', 'examType', 'subjectId', 'subjectName', 'topicId', 'topicName',
        'testId', 'testTitle', 'correctCount', 'wrongCount', 'emptyCount', 'ungradedCount',
        'durationSeconds', 'answersMapJson', 'testSnapshotJson', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId == request.auth.uid
        && data.examType is string && (data.examType == 'TYT' || data.examType == 'AYT')
        && data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 64
        && data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 100
        && data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 64
        && data.topicName is string && data.topicName.size() >= 1 && data.topicName.size() <= 120
        && data.testId is string && data.testId.size() >= 1 && data.testId.size() <= 64
        && data.testTitle is string && data.testTitle.size() >= 1 && data.testTitle.size() <= 150
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 200
        && data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 200
        && data.emptyCount is int && data.emptyCount >= 0 && data.emptyCount <= 200
        && data.ungradedCount is int && data.ungradedCount >= 0 && data.ungradedCount <= 200
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 36000
        && data.answersMapJson is string && data.answersMapJson.size() >= 0 && data.answersMapJson.size() <= 5000
        && data.testSnapshotJson is string && data.testSnapshotJson.size() <= 900000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomQuestion(data) {
      let keys = [
        'userId', 'examType', 'subjectId', 'subjectName', 'topicId', 'topicName',
        'difficulty', 'correctOption', 'questionText', 'publisherTag',
        'aiSolutionSummary', 'cropAspectRatio', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId == request.auth.uid
        && data.examType is string && (data.examType == 'TYT' || data.examType == 'AYT')
        && data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 64
        && data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 100
        && data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 64
        && data.topicName is string && data.topicName.size() >= 1 && data.topicName.size() <= 120
        && data.difficulty is string && (data.difficulty == 'Kolay' || data.difficulty == 'Orta' || data.difficulty == 'Zor')
        && data.correctOption is string && (data.correctOption == 'A' || data.correctOption == 'B' || data.correctOption == 'C' || data.correctOption == 'D' || data.correctOption == 'E')
        && data.questionText is string && data.questionText.size() >= 1 && data.questionText.size() <= 2000
        && data.publisherTag is string && data.publisherTag.size() >= 1 && data.publisherTag.size() <= 120
        && data.aiSolutionSummary is string && data.aiSolutionSummary.size() >= 0 && data.aiSolutionSummary.size() <= 4000
        && (data.cropAspectRatio is int || data.cropAspectRatio is float)
        && data.cropAspectRatio >= 0.2 && data.cropAspectRatio <= 5.0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /test_results/{resultId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(resultId) && isValidTestResult(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidTestResult(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /custom_questions/{questionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(questionId) && isValidCustomQuestion(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidCustomQuestion(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
